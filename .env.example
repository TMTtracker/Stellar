VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Ollama Cloud (https://ollama.com/settings/keys) — key stays in local .env, never commit it
VITE_OLLAMA_API_KEY=
VITE_OLLAMA_MODEL=gemma4:31b-cloud
# Same-origin dev proxy (see vite.config.js). Only point this at
# https://ollama.com/api directly if your host allows browser CORS.
VITE_OLLAMA_BASE_URL=/api/ollama